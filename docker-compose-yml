version: '3.8'

services:
  antigravity-proxy:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: antigravity-claude-proxy
    restart: unless-stopped
    ports:
      - "${PORT:-8080}:8080"
    environment:
      - PORT=8080
      - HOST=0.0.0.0
      - DATA_DIR=/app/data
      - PUBLIC_URL=${PUBLIC_URL:-}
      - WEBUI_PASSWORD=${WEBUI_PASSWORD:-}
      - API_KEY=${API_KEY:-}
      - DEBUG=${DEBUG:-false}
      - DEV_MODE=${DEV_MODE:-false}
      - FALLBACK=${FALLBACK:-false}
    volumes:
      - antigravity-data:/app/data
    deploy:
      resources:
        limits:
          memory: 768M
        reservations:
          memory: 256M

volumes:
  antigravity-data:
    name: antigravity-data
